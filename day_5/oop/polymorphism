with inheritence
class Animal:
    def sound(self):
        print("Some sound")
class Dog(Animal):
    def sound(self):
        print("Woof")
class Cat(Animal):
    def sound(self):
        print("Meow")
        
without inhertence
class Dog:
    def sound(self):
        print("Woof")
class Cat:
    def sound(self):
        print("Meow")
