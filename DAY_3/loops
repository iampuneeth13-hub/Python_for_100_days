#while_loop
count = 1
while count <= 5:
    print(count)
    count += 1

#for_loop
for i in range(5):
    print(i)

#advanced_for_loop    
fruits = ["apple", "banana", "cherry"]
for fruit in fruits:
    print(fruit)

#break_method
for i in range(1, 6):
    if i == 4:
        break
    print(i)
    
#continue_method
for i in range(1, 6):
   if i == 3:
    continue
   print(i)

#pass_method
for i in range(3):
    pass

#nested_loop
for i in range(1, 4):
    for j in range(1, 3):
        print(i, j)

#else_loop
for i in range(3):
    print(i)
else:
    print("Loop completed!")

